<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SledCoopMod</AssemblyName>
    <RootNamespace>SledCoopMod</RootNamespace>
    <!-- Copy built DLL into BepInEx plugins folder on build (done via Target below) -->
  </PropertyGroup>

  <!--
    ── NuGet packages (resolve without local files) ─────────────────────────────
    BepInEx 6 IL2CPP + HarmonyX + Il2CppInterop come from the BepInEx NuGet feed
    configured in nuget.config.  The BepInEx.Unity.IL2CPP package also provides
    the Il2CppInterop.Runtime assembly that wraps core Unity/system types.
  -->
  <ItemGroup>
    <!--
      BepInEx.Unity.IL2CPP: includes BepInEx.Core, HarmonyX, Il2CppInterop.Runtime.
      Pin to a specific stable pre-release once chosen; "6.*" picks latest.
    -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" />
  </ItemGroup>

  <!--
    Legacy clone-mode source kept for reference but excluded from compile.
    The networked-instance rework (docs/networked-instance-rework/) replaces
    in-process pawn cloning with real FishNet client child processes; the
    types LocalCoopMovement / LocalCoopActions / LocalPlayer / GuestRacingTracker
    that LocalPlayerSpawner.cs references no longer exist.
  -->
  <ItemGroup>
    <Compile Remove="src/LocalPlayerSpawner.cs" />
  </ItemGroup>

  <!--
    ── Compile-time reference DLLs ───────────────────────────────────────────────
    Unity Engine base assemblies: use Unity Editor 6000.3 managed DLLs as compile
    stubs (proper .NET assemblies with correct NullableAttribute etc.).
    Game-specific assemblies: use BepInEx/interop/ generated on first game launch.
  -->
  <PropertyGroup>
    <UnityEditorManaged>/home/zander/Unity/Hub/Editor/6000.3.8f1/Editor/Data/Managed</UnityEditorManaged>
    <UnityEditorModules>$(UnityEditorManaged)/UnityEngine</UnityEditorModules>
    <UnityEditorPackages>/home/zander/Unity/Hub/Editor/6000.3.8f1/Editor/Data/Resources/PackageManager/ProjectTemplates/libcache/com.unity.template.3d-cross-platform-17.0.14/ScriptAssemblies</UnityEditorPackages>
    <GameInterop>/home/zander/.steam/debian-installation/steamapps/common/Sledding Game Demo/BepInEx/interop</GameInterop>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game types: generated by BepInEx on first launch -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameInterop)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- IL2CPP BCL interop (Il2CppSystem.String, Il2CppSystem.Object, etc.) -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameInterop)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Engine core types (MonoBehaviour, GameObject, Camera, Rect, …) -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.AudioListener -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.Physics -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.Animator -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.Canvas, RectTransform, etc. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- GUIStyle, GUI, OnGUI, Texture2D -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.Input (legacy input system: GetKey, GetAxis, etc.) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- TextAnchor enum (used by GUIStyle.alignment) -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityEditorModules)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine.UI (Button, Image, Canvas scaler, etc.) -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityEditorPackages)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Input System – same version as Unity 6000 Editor -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(UnityEditorPackages)/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Cinemachine + FishNet + URP: exact game versions from interop -->
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>$(GameInterop)/Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Cinemachine">
      <HintPath>$(GameInterop)/Unity.Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FishNet.Runtime">
      <HintPath>$(GameInterop)/FishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(GameInterop)/UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(GameInterop)/Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.lightbug.character-controller-pro">
      <HintPath>$(GameInterop)/com.lightbug.character-controller-pro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the built DLL to BepInEx/plugins/ after a successful build -->
  <Target Name="CopyToBepInExPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(MSBuildProjectDirectory)/../BepInEx/plugins/SledCoopMod.dll"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
